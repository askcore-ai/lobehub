<view class="page">
  <view class="card">
    <view class="brand">AskCore</view>
    <view class="title">{{title}}</view>
    <view class="detail">{{detail}}</view>
    <button
      wx:if="{{status === 'ready' && !invalid}}"
      class="primary"
      disabled="{{busy}}"
      loading="{{busy}}"
      bindtap="onAuthorize"
    >
      {{actionText}}
    </button>
  </view>
</view>
