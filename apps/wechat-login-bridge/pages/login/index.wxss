.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 96rpx 40rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e8eaf0;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(31, 35, 41, 0.08);
  padding: 56rpx 40rpx;
}

.brand {
  color: #3370ff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.detail {
  color: #646a73;
  font-size: 30rpx;
  line-height: 1.6;
  margin: 24rpx 0 48rpx;
}

.primary {
  background: #3370ff;
  border-radius: 16rpx;
  color: #ffffff;
}

.success {
  color: #20a162;
  font-size: 32rpx;
  font-weight: 600;
}
