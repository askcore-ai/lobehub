.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 96rpx 40rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e8eaf0;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(31, 35, 41, 0.08);
  padding: 56rpx 40rpx;
}

.brand {
  color: #3370ff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.detail {
  color: #646a73;
  font-size: 30rpx;
  line-height: 1.6;
  margin: 24rpx 0 48rpx;
}

.primary {
  background: #3370ff;
  border-radius: 16rpx;
  color: #ffffff;
}

.success {
  color: #20a162;
  font-size: 32rpx;
  font-weight: 600;
}

.steps {
  color: #3f4652;
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 36rpx;
}

.steps view + view {
  margin-top: 12rpx;
}

.privacy {
  color: #646a73;
  font-size: 24rpx;
  line-height: 1.7;
  margin-top: 36rpx;
}

.manual {
  border-top: 1rpx solid #e8eaf0;
  font-size: 26rpx;
  line-height: 1.7;
  margin: 32rpx 0;
  padding-top: 28rpx;
}

.manual-title { font-weight: 600; }

.manual input {
  border: 1rpx solid #bcc3ce;
  border-radius: 12rpx;
  font-family: monospace;
  font-size: 28rpx;
  height: 80rpx;
  margin: 24rpx 0;
  padding: 0 16rpx;
}
